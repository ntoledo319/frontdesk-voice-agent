# Required for live microphone mode (AssemblyAI Universal-Streaming)
ASSEMBLYAI_API_KEY=

# Optional: upgrade field extraction with any OpenAI-compatible endpoint
# (OpenAI, OpenRouter, Ollama at http://localhost:11434/v1, ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: POST captured leads to a webhook (e.g. Google Apps Script -> Sheet)
INTAKE_WEBHOOK_URL=
